    "@react-three/fiber": "9.8.2",
    "@t3-oss/env-nextjs": "catalog:prod",
    "geist": "catalog:frontend",
    "lodash": "4.18.1",
    "motion": "catalog:frontend",
    "next": "catalog:framework",
    "react": "catalog:framework",
    "react-dom": "catalog:framework",
    "react-hotkeys-hook": "catalog:frontend",
    "three": "0.187.0",
    "three-globe": "2.45.6",
    "zod": "catalog:utils"
  },
  "devDependencies": {
    "@pbn/eslint-config": "workspace:*",
    "@pbn/prettier-config": "workspace:*",
    "@pbn/tailwind-config": "workspace:*",
    "@pbn/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "catalog:build",
    "@types/lodash": "catalog:types",
    "@types/node": "catalog:types",
    "@types/react": "catalog:types",
    "@types/react-dom": "catalog:types",
    "dotenv-cli": "catalog:script",
    "eslint": "catalog:lint",
    "jiti": "catalog:script",
    "prettier": "catalog:lint",
    "tailwindcss": "catalog:build",
    "typescript": "catalog:types"
