    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "start": "pnpm with-env next start",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@calcom/embed-react": "1.5.3",
    "@headlessui/react": "catalog:frontend",
    "@pbn/ui": "workspace:*",
