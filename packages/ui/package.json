{
  "name": "@pbn/ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": [
      "./src/*.tsx",
      "./src/*.ts"
    ]
  },
  "license": "MIT",
  "scripts": {
    "clean": "rm -rf .turbo node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "ui-add": "pnpm dlx shadcn@4.23.0 add && prettier src --write --list-different"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tooltip": "1.4.1",
    "class-variance-authority": "catalog:utils",
    "embla-carousel-react": "8.6.0",
    "next-themes": "catalog:frontend",
    "react-icons": "5.7.0",
    "sonner": "catalog:frontend",
    "tailwind-merge": "catalog:frontend"
  },
  "devDependencies": {
    "@pbn/eslint-config": "workspace:*",
    "@pbn/prettier-config": "workspace:*",
    "@pbn/tsconfig": "workspace:*",
    "@types/node": "catalog:types",
    "@types/react": "catalog:types",
    "eslint": "catalog:lint",
    "prettier": "catalog:lint",
    "react": "catalog:framework",
    "typescript": "catalog:types",
    "typescript-native": "catalog:types"
  },
  "peerDependencies": {
    "react": "catalog:framework"
  },
  "prettier": "@pbn/prettier-config"
}
